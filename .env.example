# --- Provider selection -------------------------------------------------
# "anthropic" = run locally against the Anthropic API directly (fastest way
#               to demo this project without an AWS account).
# "bedrock"   = run against AWS Bedrock (the production path).
LLM_PROVIDER=anthropic

# --- Anthropic direct (used when LLM_PROVIDER=anthropic) ----------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- AWS Bedrock (used when LLM_PROVIDER=bedrock) ------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0

# --- Pipeline behavior ----------------------------------------------------
MIN_CONFIDENCE_FOR_AUTO_APPROVAL=0.85
MAX_RETRIES_PER_AGENT=2
OUTPUT_DIR=data/output
